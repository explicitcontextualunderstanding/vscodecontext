{
  "name": "vscode-context",
  "version": "0.0.6",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/vscode-context.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "dependencies": {
    "generator-code": "^1.11.5"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:vscode-context.extractContext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.extractContext",
        "title": "Extract VSCode Context"
      }
    ]
  },
  "scripts": {
    "watch": "tsc -w",
    "compile": "tsc",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0"
  }
}
