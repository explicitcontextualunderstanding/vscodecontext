{
  "name": "vscode-context",
  "version": "0.8.0",
  "publisher": "rooveterinaryinc",
  "main": "./extension/dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/explicitcontextualunderstanding/vscodecontext"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.extractContext",
        "title": "Extract VSCode Context"
      }
    ],
    "configuration": {
      "title": "VSCode Context",
      "properties": {
        "vscode-context.enableWorkspaceContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering workspace-related context (e.g., opened folders, configuration)."
        },
        "vscode-context.enableEditorContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering editor-related context (e.g., active editor, selections)."
        },
        "vscode-context.enableTerminalContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering terminal-related context (e.g., active terminal, terminals)."
        },
        "vscode-context.enableDebugContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering debug-related context (e.g., active debug session)."
        },
        "vscode-context.enableScmContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering SCM-related context (e.g., source control repositories)."
        },
        "vscode-context.enableTasksContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering tasks-related context (e.g., available tasks)."
        },
        "vscode-context.enableExtensionContext": {
          "type": "boolean",
          "default": true,
          "description": "Enable gathering extension-related context (e.g., global and workspace state)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run lint && tsc",
    "postbuild": "npm run sonar",
    "sonar": "npx sonarqube-scanner -Dsonar.organization=explicitcontextualunderstanding -Dsonar.projectKey=vscodecontext",
    "lint": "NODE_OPTIONS=--max_old_space_size=4096 eslint . --config eslint.config.mjs && markdownlint '**/*.md' --dot -p .markdownlintignore || true",
    "test": "jest",
    "prepare": "npm run build",
    "docs": "typedoc --out docs src",
    "compile": "rimraf extension/dist && tsc -p ./ && ls extension/dist && cp package.json extension/dist/",
    "vscode:prepublish": "npm run compile",
    "postinstall": "echo 'VSCode extension post-install complete'",
    "quality": "npm run lint && npm run format && npm run lint:markdown && npm run docs",
    "full-build": "npm run quality && webpack --mode production",
    "watch": "webpack --watch --mode development",
    "lint:markdown": "markdownlint .",
    "lint:markdown:verify": "markdownlint . --list-files",
    "format": "prettier --write src/**/*.ts",
    "sonar-scan": "node sonar-project.cjs",
    "prebuild": "npm run sonar-scan",
    "clean": "rimraf out coverage *.vsix",
    "purge": "npm run clean && code --uninstall-extension ${npm_package_name} || exit 0",
    "rebuild": "npm run clean && npm install && npm run build",
    "reinstall": "vsce package && code --uninstall-extension ${npm_package_name} && code --install-extension ./${npm_package_name}-${npm_package_version}.vsix",
    "refresh": "npm run purge && npm run rebuild && npm run reinstall"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@types/jest": "^29.5.14",
    "@types/markdownlint": "^0.13.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/vscode": "^1.96.0",
    "@types/web": "^0.0.197",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "markdownlint-cli": "^0.43.0",
    "node-cache": "5.1.2",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.6",
    "typescript": "^5.0.4",
    "vitest": "^3.0.3",
    "vitest-mock-extended": "^2.0.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "winston": "3.14.0"
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.26.5",
    "@html-eslint/eslint-plugin": "0.20.0",
    "@html-eslint/parser": "0.20.0",
    "preact": "^10.25.4"
  }
}
