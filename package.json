{
  "name": "vscode-context",
  "version": "0.0.7",
  "type": "commonjs",
  "main": "./out/extension.cjs",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "git@github.com:explicitcontextualunderstanding/vscodecontext.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "dependencies": {
    "@types/node-cache": "^4.1.3",
    "eslint-plugin-sonarjs": "^3.0.1",
    "node-cache": "^5.1.2",
    "winston": "^3.13.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.extractContext",
        "title": "Extract VSCode Context"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && cp package.json out/package.json && sed -i '' 's/\"type\": \"module\"/\"type\": \"commonjs\"/' out/package.json",
    "vscode:prepublish": "npm run compile",
    "postinstall": "node ./node_modules/vscode/bin/install",
    "docs": "typedoc",
    "quality": "npm run lint && npm run format && npm run lint:markdown && npm run docs",
    "build": "npm run quality && webpack --mode production",
    "watch": "webpack --watch --mode development",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:markdown": "markdownlint '**/*.md' --ignore 'node_modules/**' --ignore 'dist/**' --ignore 'out/**' --ignore 'coverage/**'",
    "format": "prettier --write src/**/*.ts",
    "prepare": "husky install",
    "sonar": "npx sonarqube-scanner -Dsonar.organization=explicitcontextualunderstanding -Dsonar.projectKey=vscodecontext",
    "postbuild": "npm run sonar",
    "test": "jest",
    "reinstall": "npm run build && code --uninstall-extension ./vscode-context-0.0.7.vsix && code --install-extension ./vscode-context-0.0.7.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.0.0",
    "sonarqube-scanner": "^4.2.6",
    "ts-loader": "^9.5.2",
    "typedoc": "^0.26.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.21.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm run lint && npm run lint:markdown && npm run docs"
    }
  }
}
