{
  "name": "vscode-context",
  "version": "0.0.6",
  "type": "module",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/vscode-context.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "dependencies": {
    "generator-code": "^1.11.5"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:vscode-context.extractContext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.extractContext",
        "title": "Extract VSCode Context"
      }
    ]
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "lint": "eslint src --ext .ts",
    "lint:markdown": "markdownlint '**/*.md'",
    "format": "prettier --write src/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "markdownlint-cli": "^0.35.0",
    "prettier": "^3.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
