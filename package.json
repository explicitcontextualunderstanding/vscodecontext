{
  "name": "vscode-context",
  "version": "0.0.2",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/vscode-context.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "dependencies": {
    "generator-code": "^1.11.5"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:vscode-context.extractContext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.extractContext",
        "title": "Extract VSCode Context"
      }
    ]
  },
  "scripts": {
    "watch": "tsc -w",
    "compile": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.3"
  }
}
