{
  "name": "vscode-context",
  "version": "0.0.1",
  "description": "VSCode extension that provides context to AI assistants",
  "type": "module",
  "main": "extension/extension.js",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:debug": "webpack --mode development --env debug",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test:e2e": "vitest run --config ./vitest.e2e.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky install",
    "status": "node scripts/checklist-status.mjs",
    "status:todo": "node scripts/checklist-status.mjs --incomplete",
    "sonar": "cross-env npx sonarqube-scanner -Dsonar.organization=explicitcontextualunderstanding -Dsonar.projectKey=vscodecontext"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.exportProblems",
        "title": "Export VSCode Problems to Output"
      }
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.23.3",
    "@esbuild-kit/esm-loader": "^2.6.5",
    "@types/jest": "^29.5.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.8",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^3.0.4",
    "@vitest/ui": "^3.0.4",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.6",
    "typescript": "^5.0.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.4",
    "vitest-mock-extended": "^2.0.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "winston": "3.14.0"
  },
  "dependencies": {
    "@kieranrc/lib": "file:../lib",
    "@modelcontextprotocol/sdk": "latest",
    "axios": "^1.6.5",
    "quick-lru": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "lint:markdown": "markdownlint . --ignore-path .gitignore",
  "test": "vitest run",
  "test:watch": "vitest watch",
  "test:ui": "vitest --ui",
  "test:coverage": "vitest run --coverage",
  "test:e2e": "ts-node ./tests/integration/runTest.ts",
  "test:all": "npm run test && npm run test:e2e",
  "prepare": "husky install",
  "vscode:prepublish": "npm run build",
  "postinstall": "echo 'VSCode extension post-install complete'",
  "quality": "npm run lint && npm run format && npm run lint:markdown",
  "watch": "webpack --watch --mode development",
  "clean": "rimraf out coverage *.vsix",
  "reinstall": "vsce package && code --uninstall-extension ${npm_package_name} && code --install-extension ./${npm_package_name}-${npm_package_version}.vsix",
  "refresh": "npm run purge && npm run rebuild && npm run reinstall",
  "type-check": "tsc --noEmit",
  "type-check:strict": "tsc --noEmit --strict",
  "type-check:watch": "tsc --noEmit --watch",
  "validate": "npm run type-check && npm run quality && npm run test:all",
  "setup": "npm install && npm run prepare && node scripts/setup-vscode.js",
  "pre-commit": "lint-staged && npm run type-check",
  "pre-push": "npm run validate",
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "tabWidth": 2,
    "semi": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "endOfLine": "lf"
  }
}
