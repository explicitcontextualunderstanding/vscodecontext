{
  "name": "vscode-context",
  "version": "0.0.6",
  "type": "commonjs",
  "publisher": "your-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/vscode-context.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "dependencies": {
    "eslint-plugin-sonarjs": "^3.0.1",
    "generator-code": "^1.11.5"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onCommand:vscode-context.extractContext"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vscode-context.extractContext",
        "title": "Extract VSCode Context"
      }
    ]
  },
  "scripts": {
    "docs": "typedoc",
    "quality": "npm run lint && npm run format && npm run lint:markdown && npm run docs",
    "build": "npm run quality && webpack --mode production",
    "watch": "webpack --watch --mode development",
    "lint": "eslint src --ext .ts",
    "lint:markdown": "markdownlint '**/*.md' --ignore 'node_modules/**' --ignore 'dist/**' --ignore 'out/**' --ignore 'coverage/**'",
    "format": "prettier --write src/**/*.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.0.0",
    "sonarqube-scanner": "^4.2.6",
    "ts-loader": "^9.5.2",
    "typedoc": "^0.26.0",
    "typescript": "^5.6.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm run lint && npm run lint:markdown && npm run docs"
    }
  }
}
