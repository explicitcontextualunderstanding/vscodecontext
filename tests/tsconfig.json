{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node", "vscode", "vitest/globals"],
    "rootDir": "..",
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "vscode": ["../__mocks__/vscode"],
      "*": ["*", "*.js"]
    },
    "baseUrl": ".",
    "skipLibCheck": true
  },
  "include": [
    "./**/*",
    "../src/**/*",
    "../package.json"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "integration/**/*"
  ]
}
