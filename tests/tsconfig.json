{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "vscode", "vitest/globals"],
    "rootDir": "..",
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "vscode": ["__mocks__/vscode"],
      "@/*": ["../src/*"]
    },
    "baseUrl": ".",
    "outDir": "../out/test",
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../src/**/*", "../package.json"],
  "exclude": ["node_modules", ".vscode-test", "integration/**/*"]
}
