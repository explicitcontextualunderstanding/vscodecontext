{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vscode", "vitest/globals"],
    "rootDir": ".",
    "outDir": "../out/test",
    "strict": true,
    "composite": true,
    "noImplicitAny": false
  },
  "include": [
    ".",
    "../src/**/*"
  ],
  "references": [
    {
      "path": ".."
    }
  ]
}
