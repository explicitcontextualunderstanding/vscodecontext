{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Production",
      "command": "npm",
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Files successfully emitted",
          "endsPattern": "^(?!Files successfully emitted)"
        }
      }
    },
    {
      "label": "Watch: Development",
      "command": "npm",
      "args": ["run", "watch"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Files successfully emitted",
          "endsPattern": "^(?!Files successfully emitted)"
        }
      },
      "isBackground": true
    },
    {
      "label": "Test: Unit",
      "command": "npm",
      "args": ["run", "test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "vitest",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^\\s*(?:ERROR|FAIL)\\s+(.+)\\s+›\\s+(.+)$",
          "file": 1,
          "message": 2
        }
      }
    },
    {
      "label": "Test: E2E",
      "command": "npm",
      "args": ["run", "test:e2e"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "vitest",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": {
          "regexp": "^\\s*(?:ERROR|FAIL)\\s+(.+)\\s+›\\s+(.+)$",
          "file": 1,
          "message": 2
        }
      }
    },
    {
      "label": "Lint: TypeScript",
      "command": "npm",
      "args": ["run", "lint"],
      "group": "lint",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "eslint",
        "source": "eslint",
        "pattern": {
          "regexp": "^([^\\s].*)\\[(\\d+), (\\d+)\\]:\\s+(.*)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    },
    {
      "label": "Format: Check",
      "command": "npm",
      "args": ["run", "format:check"],
      "group": "format",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "prettier",
        "pattern": {
          "regexp": "^([^\\s].*)\\s+(\\d+):(\\d+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "Format: Write",
      "command": "npm",
      "args": ["run", "format"],
      "group": "format",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Type Check",
      "command": "npm",
      "args": ["run", "type-check"],
      "group": "typecheck",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": ["relative", "${workspaceRoot}"],
        "pattern": "$tsc"
      }
    },
    {
      "label": "Clean Project",
      "command": "npm",
      "args": ["run", "clean"],
      "group": "clean",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
