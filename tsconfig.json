{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "moduleResolution": "node",
    "types": ["node", "vscode"],
    "esModuleInterop": true,
    "paths": {
      "vscode": ["./tests/__mocks__/vscode.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
