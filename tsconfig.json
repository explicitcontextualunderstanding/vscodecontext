{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2022",
        "outDir": "./out",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "sourceMap": true,
        "types": ["node", "@types/vscode", "jest"]
    },
    "include": [
      "src/**/*",
      "**/*.config.*",
      "eslint.config.mjs"
    ],
    "exclude": [
        "node_modules",
        "out"
    ]
}
